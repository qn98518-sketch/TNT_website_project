# Copy to backend/.env on the PHP host (never commit real secrets).
APP_ENV=production
# Public NEXT.JS origin, not the PHP backend origin. No trailing slash.
CMS_PUBLIC_URL=https://your-website.example
CMS_SHARED_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tnt_cms
DB_USERNAME=tnt_cms
DB_PASSWORD=
# Docker Compose only; a different strong password from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
# Optional CA file for a remote MySQL TLS connection.
DB_SSL_CA=
# Session storage must be persistent and writable by PHP, outside public/.
CMS_SESSION_PATH=
