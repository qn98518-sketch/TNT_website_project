# Next.js website + CMS: local .env.local / Vercel Environment Variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase Connect > Transaction pooler (port 6543). URL-encode the password.
# PostgreSQL URL only; this is NOT a Supabase API key or project HTTPS URL.
DATABASE_URL=
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CMS_SESSION_SECRET=
# Optional: direct/session pooler URL for local migration commands only.
# CMS_MIGRATION_DATABASE_URL=
# Optional PEM root CA from the Supabase dashboard if TLS verification requires it.
# DATABASE_SSL_CA=
# Do not put database/session/admin credentials in NEXT_PUBLIC_* variables.
